<div class="sidebar sidebar-fixed sidebar-dark bg-dark-gradient border-end <%= current_user&.sidebar_narrow? ? "sidebar-narrow-unfoldable" : "" -%>" id="sidebar" data-controller="sidebar">
  <div class="sidebar-header border-bottom">
    <div class="sidebar-brand">
      <%= link_to root_path, class: "text-reset text-decoration-none" do %>
        <svg alt="CoreUI Logo" class="sidebar-brand-full" height="32" width="110">
          <use xlink:href="<%= asset_path("coreui.svg#full") %>"></use>
        </svg>
      <% end %>
      <%= link_to root_path, class: "text-reset text-decoration-none" do %>
        <svg alt="CoreUI Logo" class="sidebar-brand-narrow" height="32" width="32">
          <use xlink:href="<%= asset_path("coreui.svg#signet") %>"></use>
        </svg>
      <% end %>
    </div>
    <button class="sidebar-toggler" type="button" data-action="sidebar#toggle" aria-label="Toggle narrow sidebar"></button>
    <button class="btn-close d-lg-none" type="button" data-action="coreui#toggleSidebar" data-coreui-target="#sidebar" data-coreui-theme="dark" aria-label="Close"></button>
  </div>
  <ul class="sidebar-nav" data-coreui="navigation" data-simplebar>
    <%= nav_item(t(".dashboard"), root_path, "free.svg#cil-speedometer") do %>
      <span class="badge bg-primary ms-auto">NEW</span>
    <% end %>

    <li class="nav-title"><%= t("user.account") -%></li>
    <%= nav_item(t("user.users"), admin_users_path, "free.svg#cil-user") %>
    <li class="nav-group <%= %w[role_users roles].include?(controller_name) ? "show" : "" -%>" data-controller="expender"
      data-expender-loaded-value="<%= %w[role_users roles].include?(controller_name) -%>"
      data-expender-url-value="<%= expender_admin_roles_path -%>">
      <a class="nav-link nav-group-toggle" data-action="expender#click" href="#">
        <%= svg_icon("free.svg#cil-functions", "nav-icon rotate_180") -%>
        <%= t("user.roles") -%>
      </a>
      <ul class="nav-group-items compact" data-expender-target="htc">
        <% if %w[role_users roles].include?(controller_name) %>
          <%= render "admin/roles/expender", roles: policy_scope(Role).all -%>
        <% end %>
      </ul>
    </li>
  </ul>
</div>
