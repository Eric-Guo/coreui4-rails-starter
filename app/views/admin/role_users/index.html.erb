<div class="row justify-content-center">
  <div class="col-lg-12">
    <div class="container">
      <table class="table table-striped table-bordered">
        <thead>
          <tr>
            <th><%= t('user.email') -%></th>
            <th><%= t('user.preferred_language') -%></th>
            <th><%= t('form.action') -%></th>
          </tr>
        </thead>
        <tbody>
          <% @role_users.each do |role_user| %>
            <tr>
              <td><%= role_user.user.email -%></td>
              <td><%= role_user.user.preferred_language -%></td>
              <td>
                <%= button_to admin_role_role_user_path(role_id: role_user.role_id, id: role_user.id), method: :delete, class: "btn btn-sm btn-danger" do -%>
                  <%= t("form.remove") -%>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
